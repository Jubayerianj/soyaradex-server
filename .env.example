# A key AgentExecutor accepts as a relayer: its authorisedAgent, or an address
# the owner added with setAgentAuthorisation(address, true). Needs a little GEN
# for gas. Without it the server records trades but does not settle them.
RELAYER_PRIVATE_KEY=

# Shared secret. The Soyara app sends it as "Authorization: Bearer <key>" to
# hand trades over. Use a long random string, and set the same value as
# SETTLEMENT_SERVER_KEY in the app.
SERVER_API_KEY=

# Where the record of queued trades is kept. On Railway, mount a volume at /data
# so a redeploy keeps it.
STORE_PATH=/data/settlements.json

# Optional. Defaults are the live GenLayer Bradbury deployment.
# RPC_URL=https://rpc-bradbury.genlayer.com
# EXECUTOR_ADDRESS=0x1BCBad3da718690fa60289DcBF15835e5C79021f
# VALIDATOR_ADDRESS=0xd1D809A1210cc039AEdBF5cD04628416Ad0e6a92
# KEEPER_INTERVAL_MS=30000
# PORT=4000
